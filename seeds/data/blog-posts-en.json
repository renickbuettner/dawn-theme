                                "file": "dawn/autumn-desk.jpg",
                                "label": ""
                            }
                        ]
                    },
                    "settings": {},
                    "id": "b_a29bb4ff"
                },
                {
                    "type": "cta",
                    "data": {
                        "variant": "bookmark",
                        "title": "Save this checklist",
                        "text": "Bookmark it for your next content sprint.",
                        "button_label": "Back to the blog",
                        "button_url": "october://cms-page@link/blog",
                        "button_style": "primary"
                    },
                    "settings": {
